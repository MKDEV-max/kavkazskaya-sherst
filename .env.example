# Скопируйте этот файл в .env и заполните. Файл .env не попадает в GitHub.

# Адрес сайта, куда ЮKassa вернёт покупателя после оплаты
PUBLIC_URL=https://ваш-домен.ru
PORT=3000

# Личный кабинет ЮKassa → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Ставка НДС в чеке: 1 — без НДС (УСН, патент), 4 — 20%, 11 — 5%, 12 — 7%
VAT_CODE=1

# Необязательно: уведомления об оплаченных заказах в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
